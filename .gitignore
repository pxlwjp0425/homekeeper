# ============================================================
# homekeeper — Git 忽略规则
# 原则：源码 / 文档 / 脚本入库；构建产物、大体积素材、
#       调试截图与本地取证 dump 一律不入库。
# ============================================================

# ---- 构建产物 ----
build/
app/build/
.gradle/
*.apk
*.aab
*.class
*.jar
*.dex

# ---- 本地大体积素材（保留在本地，不入库）----
/dist/
/bing-import/out/
/audiofix/tone*.wav

# ---- 调试截图 / 屏幕取证（仅根目录与图库目录）----
/*.png
/*.jpg
/bing-import/*.png
/bing-import/*.jpg

# ---- 本地取证导出（dumpsys / dumpsys window 等，含设备私密信息）----
/*.txt
/ui*.xml

# ---- 一次性调试脚本（仅根目录；audiofix/ 下的成体系脚本正常入库）----
/*.sh

# ---- 编辑器 / 操作系统 ----
.idea/
*.iml
.DS_Store
Thumbs.db
*.log
*.pid
